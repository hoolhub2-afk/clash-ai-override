{
  "mixed-port": 7890,
  "mode": "rule",
  "log-level": "info",
  "proxies": [],
  "proxy-providers": {
    "sub1": {
      "type": "file",
      "path": "provider-test.yaml",
      "health-check": {
        "enable": true,
        "url": "http://cp.cloudflare.com/generate_204",
        "interval": 300
      }
    }
  },
  "ipv6": false,
  "allow-lan": true,
  "bind-address": "*",
  "authentication": [
    "lan:CHANGE_ME"
  ],
  "skip-auth-prefixes": [
    "127.0.0.1/32",
    "::1/128",
    "172.16.0.0/12",
    "192.168.65.0/24"
  ],
  "find-process-mode": "strict",
  "keep-alive-idle": 600,
  "keep-alive-interval": 15,
  "disable-keep-alive": false,
  "tcp-concurrent": false,
  "unified-delay": true,
  "profile": {
    "store-selected": true,
    "store-fake-ip": true
  },
  "listeners": [
    {
      "name": "docker-in",
      "type": "mixed",
      "port": 7895,
      "listen": "0.0.0.0",
      "users": [
        {
          "username": "lan",
          "password": "CHANGE_ME"
        }
      ]
    }
  ],
  "tun": {
    "enable": true,
    "stack": "mixed",
    "dns-hijack": [
      "any:53",
      "tcp://any:53"
    ],
    "auto-route": true,
    "auto-detect-interface": true,
    "strict-route": false,
    "mtu": 1500,
    "udp-timeout": 300
  },
  "proxy-groups": [
    {
      "name": "🌐 全局代理",
      "type": "select",
      "proxies": [
        "DIRECT"
      ],
      "use": [
        "sub1"
      ],
      "exclude-filter": "(?i)((Hong\\s*Kong|HongKong|香港|🇭🇰|\\bHK\\b|\\bHKG\\b|\\bHKT\\b|\\bHKBN\\b|\\bPCCW\\b|深港|沪港|京港|广港|珠港|Macao|Macau|澳门|🇲🇴|\\bMO\\b|China|中国|大陆|回国|内地|🇨🇳|\\bCN\\b|北京|上海|广州|深圳|杭州|东莞|佛山|珠海|厦门|福州|南京|苏州|成都|重庆|武汉|长沙|郑州|西安|天津|青岛|大连|沈阳|哈尔滨|昆明|南宁|海口|三亚|乌鲁木齐|拉萨|银川|兰州|西宁|呼和浩特|太原|石家庄|济南|合肥|南昌|贵阳|长春)|(到期|剩余|流量|官网|套餐|群|重置|网址|故障|维护|expire|traffic|reset|remaining|days?\\s*left|\\d+(\\.\\d+)?\\s*[tg]b\\b|([2-9]|[1-9]\\d+)(\\.\\d+)?\\s*[xX倍]))"
    },
    {
      "name": "🤖 AI 专属 (美/日/新/韩)",
      "type": "select",
      "proxies": [
        "🌐 全局代理"
      ],
      "use": [
        "sub1"
      ],
      "filter": "(?i)((United\\s*States|美国|🇺🇸|\\bUS\\b|\\bUSA\\b|Los\\s*Angeles|San\\s*Jose|San\\s*Francisco|Seattle|New\\s*York|Dallas|Silicon\\s*Valley|Japan|日本|🇯🇵|\\bJP\\b|\\bJPN\\b|Tokyo|Osaka|Singapore|新加坡|狮城|🇸🇬|\\bSG\\b|Korea|韩国|首尔|🇰🇷|\\bKR\\b|Seoul))",
      "exclude-filter": "(?i)((Hong\\s*Kong|HongKong|香港|🇭🇰|\\bHK\\b|\\bHKG\\b|\\bHKT\\b|\\bHKBN\\b|\\bPCCW\\b|深港|沪港|京港|广港|珠港|Macao|Macau|澳门|🇲🇴|\\bMO\\b|China|中国|大陆|回国|内地|🇨🇳|\\bCN\\b|北京|上海|广州|深圳|杭州|东莞|佛山|珠海|厦门|福州|南京|苏州|成都|重庆|武汉|长沙|郑州|西安|天津|青岛|大连|沈阳|哈尔滨|昆明|南宁|海口|三亚|乌鲁木齐|拉萨|银川|兰州|西宁|呼和浩特|太原|石家庄|济南|合肥|南昌|贵阳|长春)|(到期|剩余|流量|官网|套餐|群|重置|网址|故障|维护|expire|traffic|reset|remaining|days?\\s*left|\\d+(\\.\\d+)?\\s*[tg]b\\b|([2-9]|[1-9]\\d+)(\\.\\d+)?\\s*[xX倍]))"
    },
    {
      "name": "🐳 容器专属 (JP/SG)",
      "type": "select",
      "proxies": [
        "DIRECT"
      ],
      "use": [
        "sub1"
      ],
      "filter": "(?i)((Japan|日本|🇯🇵|\\bJP\\b|\\bJPN\\b|Tokyo|Osaka|京都|名古屋|东京|大阪|Singapore|新加坡|狮城|🇸🇬|\\bSG\\b|\\bSGP\\b))",
      "exclude-filter": "(?i)((Hong\\s*Kong|HongKong|香港|🇭🇰|\\bHK\\b|\\bHKG\\b|\\bHKT\\b|\\bHKBN\\b|\\bPCCW\\b|深港|沪港|京港|广港|珠港|Macao|Macau|澳门|🇲🇴|\\bMO\\b|China|中国|大陆|回国|内地|🇨🇳|\\bCN\\b|北京|上海|广州|深圳|杭州|东莞|佛山|珠海|厦门|福州|南京|苏州|成都|重庆|武汉|长沙|郑州|西安|天津|青岛|大连|沈阳|哈尔滨|昆明|南宁|海口|三亚|乌鲁木齐|拉萨|银川|兰州|西宁|呼和浩特|太原|石家庄|济南|合肥|南昌|贵阳|长春)|(到期|剩余|流量|官网|套餐|群|重置|网址|故障|维护|expire|traffic|reset|remaining|days?\\s*left|\\d+(\\.\\d+)?\\s*[tg]b\\b|([2-9]|[1-9]\\d+)(\\.\\d+)?\\s*[xX倍]))"
    }
