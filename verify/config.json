        "🐳 容器自动测速",
        "JP Osaka 02",
        "JP Tokyo 01",
        "SG Lion 01"
      ]
    },
    {
      "name": "⚡ 优选自动 (美/日/新/韩)",
      "type": "url-test",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": 180,
      "tolerance": 50,
      "timeout": 5000,
      "lazy": true,
      "hidden": true,
      "expected-status": 204,
      "proxies": [
        "JP Osaka 02",
        "JP Tokyo 01",
        "KR Seoul 01",
        "SG Lion 01",
        "US Los Angeles 01",
        "US San Jose 02"
      ]
    },
