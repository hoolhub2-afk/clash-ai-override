      "url": "http://cp.cloudflare.com/generate_204",
      "interval": 180,
      "tolerance": 50,
      "timeout": 5000,
      "lazy": true,
      "hidden": true,
      "expected-status": 204,
      "proxies": [
        "TR Istanbul 01"
      ]
    },
    {
      "name": "⚡ 全局故障回退",
      "type": "fallback",
      "proxies": [
        "⚡ 优选自动 (美/日/新/韩)",
        "⚡ 备用自动 (其他地区)"
      ],
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": 180,
      "timeout": 5000,
      "lazy": true,
      "hidden": true,
      "expected-status": 204
    },
    {
      "name": "🤖 AI 自动 (稳态)",
