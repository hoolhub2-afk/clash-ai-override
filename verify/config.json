        "https://1.12.12.12/dns-query"
      ],
      "+.lan": [
        "system"
      ],
      "+.local": [
        "system"
      ],
      "+.home.arpa": [
        "system"
      ]
    }
  },
  "sniffer": {
    "enable": true,
    "force-dns-mapping": true,
    "parse-pure-ip": true,
    "override-destination": false,
    "sniff": {
