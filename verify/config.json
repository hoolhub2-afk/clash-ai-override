  "ipv6": false,
  "allow-lan": true,
  "bind-address": "*",
  "authentication": [
    "lan:CHANGE_ME"
  ],
  "skip-auth-prefixes": [
    "127.0.0.1/32",
    "::1/128",
    "172.16.0.0/12",
    "192.168.65.0/24"
  ],
  "find-process-mode": "strict",
  "keep-alive-idle": 600,
  "keep-alive-interval": 15,
  "disable-keep-alive": false,
  "tcp-concurrent": false,
  "unified-delay": true,
  "profile": {
    "store-selected": true,
    "store-fake-ip": true
  },
  "listeners": [
    {
      "name": "docker-in",
      "type": "mixed",
      "port": 7895,
      "listen": "0.0.0.0",
      "users": [
        {
          "username": "lan",
          "password": "CHANGE_ME"
        }
      ]
    }
  ],
  "tun": {
    "enable": true,
    "stack": "mixed",
    "dns-hijack": [
      "any:53",
      "tcp://any:53"
    ],
    "auto-route": true,
    "auto-detect-interface": true,
    "strict-route": false,
    "mtu": 1500,
    "udp-timeout": 300
  },
  "proxy-groups": [
    {
      "name": "🌐 全局代理",
      "type": "select",
      "proxies": [
        "🤖 AI 专属 (美/日/新/韩)",
